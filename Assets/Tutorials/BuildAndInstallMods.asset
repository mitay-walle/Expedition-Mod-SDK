  m_Script: {fileID: 11500000, guid: 456c7c2b477e4253b9e4faf9ed4b18a9, type: 3}
  m_Name: "6. \u041F\u0440\u043E\u0432\u0435\u0440\u043A\u0430 \u0432 \u0438\u0433\u0440\u0435 / Verify in game Instructions"
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.InstructionsParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title:
    m_Untranslated: "6. \u041F\u0440\u043E\u0432\u0435\u0440\u043A\u0430 \u0432 \u0438\u0433\u0440\u0435 / Verify in game"
  Text:
    m_Untranslated: "\u0417\u0430\u043F\u0443\u0441\u0442\u0438\u0442\u0435 \u0438\u0433\u0440\u0443 \u0437\u0430\u043D\u043E\u0432\u043E: \u043D\u0430\u0431\u043E\u0440 \u043C\u043E\u0434\u043E\u0432 \u0444\u0438\u043A\u0441\u0438\u0440\u0443\u0435\u0442\u0441\u044F \u043F\u0440\u0438 \u0441\u0442\u0430\u0440\u0442\u0435. \u041F\u0440\u043E\u0432\u0435\u0440\u044C\u0442\u0435 \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0435 Mod catalog ready \u0438 \u0444\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0435 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0435 \u043A\u043E\u043D\u0442\u0435\u043D\u0442\u0430. \u0414\u043B\u044F sample.author \u0442\u0435\u043A\u0441\u0442 \u043F\u043E \u0430\u0434\u0440\u0435\u0441\u0443 sample.author/additive/sample-text \u0434\u043E\u043B\u0436\u0435\u043D \u0441\u043E\u0432\u043F\u0430\u0441\u0442\u044C \u0441 \u0438\u0441\u0445\u043E\u0434\u043D\u044B\u043C TextAsset. \u041F\u0440\u043E\u0432\u0435\u0440\u043A\u0430 \u0444\u0430\u0439\u043B\u043E\u0432 \u0438 \u0441\u0431\u043E\u0440\u043A\u0430 \u043D\u0435 \u0434\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u044E\u0442 \u0438\u0433\u0440\u043E\u0432\u043E\u0439 \u044D\u0444\u0444\u0435\u043A\u0442.\nRestart the game. Verify catalog loading and actual gameplay use. Other sample configurations still require their domain's runtime integration; see Docs/CreatingAMod.md. \u0414\u043B\u044F \u043E\u0431\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u044F \u0437\u0430\u043A\u0440\u043E\u0439\u0442\u0435 \u0438\u0433\u0440\u0443 \u0438 \u0443\u0434\u0430\u043B\u0438\u0442\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u0442\u0430\u0440\u0443\u044E \u043F\u0430\u043F\u043A\u0443 \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u043E\u0433\u043E \u043C\u043E\u0434\u0430, \u0437\u0430\u0442\u0435\u043C \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0435 \u043D\u043E\u0432\u0443\u044E. \u041E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0439 \u043C\u043E\u0434 \u0432 \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u0438 \u0434\u043E\u043B\u0436\u0435\u043D \u0431\u044B\u0442\u044C \u044F\u0432\u043D\u043E\u0439 \u043E\u0448\u0438\u0431\u043A\u043E\u0439 \u0441\u043E\u0432\u043C\u0435\u0441\u0442\u0438\u043C\u043E\u0441\u0442\u0438."
  m_CriteriaCompletion: 0
  m_Criteria:
    m_Items: []
