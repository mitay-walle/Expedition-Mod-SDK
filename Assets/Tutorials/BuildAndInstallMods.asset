  m_Script: {fileID: 11500000, guid: 456c7c2b477e4253b9e4faf9ed4b18a9, type: 3}
  m_Name: "4. \u0421\u0431\u043E\u0440\u043A\u0430 / Build Instructions"
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.InstructionsParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title:
    m_Untranslated: "4. \u0421\u0431\u043E\u0440\u043A\u0430 / Build"
  Text:
    m_Untranslated: "\u041D\u0430\u0436\u043C\u0438\u0442\u0435 \xAB2. \u0421\u043E\u0431\u0440\u0430\u0442\u044C \u043C\u043E\u0434\xBB. \u0414\u043E\u0436\u0434\u0438\u0442\u0435\u0441\u044C \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0430. \u0412 Builds/Packages/<mod-id>-<version> \u043F\u043E\u044F\u0432\u044F\u0442\u0441\u044F mod.json, \u043A\u0430\u0442\u0430\u043B\u043E\u0433, hash \u0438 bundles. \u0414\u043B\u044F \u0432\u0441\u0435\u0433\u043E \u043D\u0430\u0431\u043E\u0440\u0430 \u0435\u0441\u0442\u044C \xAB\u0421\u043E\u0431\u0440\u0430\u0442\u044C \u0432\u0441\u0435 \u043C\u043E\u0434\u044B\xBB.\nClick Build selected and wait. Distribute the entire output folder; source assets are not an installable package."
  m_CriteriaCompletion: 0
  m_Criteria:
    m_Items:
    - Type:
        m_TypeName: Expedition.ModSdk.Editor.ModTutorialCriterion, Expedition.ModSdk.Editor, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null
      Criterion: {fileID: 8768969130272351528}
