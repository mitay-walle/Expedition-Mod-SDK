--- !u!114 &8375267567440083419
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 456c7c2b477e4253b9e4faf9ed4b18a9, type: 3}
  m_Name: "2. \u041F\u0430\u043F\u043A\u0430 \u0438 manifest / Folder and manifest Instructions"
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.InstructionsParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title:
    m_Untranslated: "2. \u041F\u0430\u043F\u043A\u0430 \u0438 manifest / Folder and manifest"
  Text:
    m_Untranslated: "\u0418\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044F \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u044F \u0438 \u0440\u0430\u0437\u043C\u0435\u0442\u043A\u0438: Docs/AssetAuthoring.md (\u0432 \u0448\u0430\u0431\u043B\u043E\u043D\u0435: Assets/Expedition Mod SDK/Documentation/Docs/AssetAuthoring.md). \u0421\u043E\u0437\u0434\u0430\u0432\u0430\u0439\u0442\u0435 \u043A\u043E\u043D\u0444\u0438\u0433\u0443\u0440\u0430\u0446\u0438\u0438 \u0447\u0435\u0440\u0435\u0437 Create, \u043D\u0430\u0437\u043D\u0430\u0447\u0430\u0439\u0442\u0435 Address, Catalog.* labels \u0438 \u0437\u0430\u043F\u0438\u0441\u044C content \u0432 mod.json. \u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 DataAndPresentation. \u041A\u0430\u0436\u0434\u044B\u0439 \u043C\u043E\u0434 \u0436\u0438\u0432\u0451\u0442 \u0432 \u0441\u0432\u043E\u0435\u0439 \u043F\u0430\u043F\u043A\u0435 Assets/Mods/<Name>: mod.json \u043E\u043F\u0438\u0441\u044B\u0432\u0430\u0435\u0442 \u0441\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u044B\u0435 ID, Content \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u0442 \u0438\u0441\u0445\u043E\u0434\u043D\u044B\u0435 assets. \u041E\u0431\u0449\u0438\u0439 API \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E \u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442 asmdef.\nChoose DataAndPresentation. Each mod has its own manifest and Content folder. The common source API is separate. \u041D\u0430\u0436\u043C\u0438\u0442\u0435 \xAB\u041E\u0442\u043A\u0440\u044B\u0442\u044C \u043F\u0430\u043F\u043A\u0443 \u043C\u043E\u0434\u0430\xBB \u0438 \u0438\u0437\u0443\u0447\u0438\u0442\u0435 mod.json. \u041D\u0435 \u043C\u0435\u043D\u044F\u0439\u0442\u0435 \u043E\u043F\u0443\u0431\u043B\u0438\u043A\u043E\u0432\u0430\u043D\u043D\u044B\u0435 ID."
  m_CriteriaCompletion: 0
  m_Criteria:
    m_Items: []
