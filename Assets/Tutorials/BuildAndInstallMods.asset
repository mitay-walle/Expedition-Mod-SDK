--- !u!114 &962141344730156694
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 456c7c2b477e4253b9e4faf9ed4b18a9, type: 3}
  m_Name: "5. \u0423\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0430 / Install Instructions"
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.InstructionsParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title:
    m_Untranslated: "5. \u0423\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0430 / Install"
  Text:
    m_Untranslated: "\u0417\u0430\u043A\u0440\u043E\u0439\u0442\u0435 \u0438\u0433\u0440\u0443. \u0423\u043A\u0430\u0436\u0438\u0442\u0435 \u0435\u0451 Application.persistentDataPath/Mods \u0438 \u043D\u0430\u0436\u043C\u0438\u0442\u0435 \xAB3. \u0423\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C \u043F\u0430\u043A\u0435\u0442\xBB. \u0412 \u043B\u043E\u043A\u0430\u043B\u044C\u043D\u043E\u0439 \u0441\u0431\u043E\u0440\u043A\u0435 Survival_2024 \u044D\u0442\u043E \u043E\u0431\u044B\u0447\u043D\u043E %USERPROFILE%/AppData/LocalLow/DefaultCompany/Survival_2024/Mods. \u041F\u0443\u0442\u044C \u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u043E\u0442 Company/Product \u0438\u0433\u0440\u044B. \u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0435 \u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0441\u0442\u0438; \u0440\u044F\u0434\u043E\u043C \u043D\u0435 \u0434\u043E\u043B\u0436\u043D\u043E \u0431\u044B\u0442\u044C \u0434\u0432\u0443\u0445 \u0432\u0435\u0440\u0441\u0438\u0439 \u043E\u0434\u043D\u043E\u0433\u043E modId.\nClose the game, choose its persistentDataPath/Mods folder and click Install selected. Install dependencies first. \u0414\u043B\u044F \u0440\u0443\u0447\u043D\u043E\u0439 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438 \u0441\u043A\u043E\u043F\u0438\u0440\u0443\u0439\u0442\u0435 \u0432\u0441\u044E \u043F\u0430\u043F\u043A\u0443 \u043F\u0430\u043A\u0435\u0442\u0430, \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0432 \u0432\u043B\u043E\u0436\u0435\u043D\u043D\u044B\u0435 \u043F\u0443\u0442\u0438."
  m_CriteriaCompletion: 0
  m_Criteria:
    m_Items:
    - Type:
        m_TypeName: Expedition.ModSdk.Editor.ModTutorialCriterion, Expedition.ModSdk.Editor, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null
      Criterion: {fileID: 1644211888537840961}
