--- !u!114 &2536544059621903737
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 456c7c2b477e4253b9e4faf9ed4b18a9, type: 3}
  m_Name: "3. \u041F\u0440\u043E\u0432\u0435\u0440\u043A\u0430 / Validate Instructions"
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.InstructionsParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title:
    m_Untranslated: "3. \u041F\u0440\u043E\u0432\u0435\u0440\u043A\u0430 / Validate"
  Text:
    m_Untranslated: "\u041D\u0430\u0436\u043C\u0438\u0442\u0435 \xAB1. \u041F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C\xBB. \u0418\u0441\u043F\u0440\u0430\u0432\u044C\u0442\u0435 \u043E\u0448\u0438\u0431\u043A\u0438, \u043F\u043E\u043A\u0430\u0437\u0430\u043D\u043D\u044B\u0435 \u0432 \u043E\u043A\u043D\u0435. \u041A\u0430\u0436\u0434\u044B\u0439 \u0430\u0434\u0440\u0435\u0441 manifest \u0434\u043E\u043B\u0436\u0435\u043D \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C asset \u0432 \u0433\u0440\u0443\u043F\u043F\u0435 \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u043E\u0433\u043E \u043C\u043E\u0434\u0430. \u041F\u0440\u044F\u043C\u044B\u0435 \u0441\u0441\u044B\u043B\u043A\u0438 \u043D\u0430 assets \u0441\u043E\u0441\u0435\u0434\u043D\u0435\u0433\u043E \u043C\u043E\u0434\u0430 \u0437\u0430\u043F\u0440\u0435\u0449\u0435\u043D\u044B: \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435 \u0441\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u044B\u0439 ID \u0438 dependencies.\nClick Validate. Every manifest address must match an entry in this mod's Addressables group."
  m_CriteriaCompletion: 0
  m_Criteria:
    m_Items:
    - Type:
        m_TypeName: Expedition.ModSdk.Editor.ModTutorialCriterion, Expedition.ModSdk.Editor, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null
      Criterion: {fileID: 7062564168639889597}
