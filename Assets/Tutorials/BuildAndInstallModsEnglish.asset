--- !u!114 &-8432950959913743659
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 456c7c2b477e4253b9e4faf9ed4b18a9, type: 3}
  m_Name: 6. Verify in game Instructions
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.InstructionsParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title:
    m_Untranslated: 6. Verify in game
  Text:
    m_Untranslated: 'Restart the game: the installed mod set is fixed at startup. Check the mod catalog ready messages, registration by the gameplay owner and actual use of the content. For sample.author, the text at sample.author/additive/sample-text must match the source TextAsset. Check both RU and EN for localized content and save/load for persistent content. A loaded catalog does not prove the complete gameplay scenario. To update a mod, stop the game, remove only that package''s previous folder and install the new version. An incompatible save must produce an explicit error instead of silently substituting content.'
  m_CriteriaCompletion: 0
  m_Criteria:
    m_Items: []
--- !u!114 &-8055192247980829766
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 456c7c2b477e4253b9e4faf9ed4b18a9, type: 3}
  m_Name: 4. Build Instructions
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.InstructionsParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title:
    m_Untranslated: 4. Build
  Text:
    m_Untranslated: Click 2. Build selected and wait for completion. Builds/Packages/<mod-id>-<version> will contain mod.json, a catalog, its hash and bundles. Build all mods builds the full set. Before distribution, run Expedition > Mod SDK > Verify Built Bundles. Distribute the entire package folder, not the source assets. The game and SDK must use compatible Editor, Addressables, URP and API versions.
  m_CriteriaCompletion: 0
  m_Criteria:
    m_Items:
    - Type:
        m_TypeName: Expedition.ModSdk.Editor.ModTutorialCriterion, Expedition.ModSdk.Editor, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null
      Criterion: {fileID: 5550302653061717769}
--- !u!114 &-7884817511331332725
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 456c7c2b477e4253b9e4faf9ed4b18a9, type: 3}
  m_Name: 5. Install Instructions
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.InstructionsParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title:
    m_Untranslated: 5. Install
  Text:
    m_Untranslated: Close the game or stop its Play Mode. Choose the game's Application.persistentDataPath/Mods directory and click 3. Install selected. For Survival_2024 on Windows this is usually %USERPROFILE%/AppData/LocalLow/DefaultCompany/Survival_2024/Mods; the path depends on the game's Company/Product settings. Install dependencies first. Do not keep two versions of the same modId installed together. To install manually, copy the entire package folder from Builds/Packages while preserving its relative paths.
  m_CriteriaCompletion: 0
  m_Criteria:
    m_Items:
    - Type:
        m_TypeName: Expedition.ModSdk.Editor.ModTutorialCriterion, Expedition.ModSdk.Editor, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null
      Criterion: {fileID: 1248592505172600616}
