  m_Name: 3. Validate Instructions
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.InstructionsParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title:
    m_Untranslated: 3. Validate
  Text:
    m_Untranslated: 'Click 1. Validate and resolve any errors shown in the workspace. Each manifest content entry must match one asset in the mod group. Check the Address and exact Catalog.* labels. Direct Unity references to another mod folder are not supported: keep configurations linked by Object fields in the same package. Declare dependencies for supported links using stable gameplay IDs. Structural validation does not prove gameplay behavior.'
  m_CriteriaCompletion: 0
  m_Criteria:
    m_Items:
    - Type:
        m_TypeName: Expedition.ModSdk.Editor.ModTutorialCriterion, Expedition.ModSdk.Editor, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null
      Criterion: {fileID: 2946191135690724617}
